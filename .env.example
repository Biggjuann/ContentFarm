# Required
ANTHROPIC_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# Reddit (https://www.reddit.com/prefs/apps — create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=contentfarm/0.1 by your_username

# X / Twitter API v2 (https://developer.x.com/en/portal/dashboard)
X_BEARER_TOKEN=

# Pipeline tuning (optional)
CONTENTFARM_MODEL=claude-opus-4-7
CONTENTFARM_HOOK_GATE_MAX_ATTEMPTS=3
CONTENTFARM_LINE_GATE_MAX_ATTEMPTS=3
CONTENTFARM_HOOK_VARIATIONS=4
